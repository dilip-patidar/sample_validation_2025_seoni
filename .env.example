# Database connection string. In the dashboard click "Connect" (top bar), pick
# "Session pooler", copy the URI and replace [YOUR-PASSWORD] with the database
# password (Project Settings > Database; "Reset database password" if unknown).
# It looks like: postgresql://postgres.dukeqyoxcrttzesivakq:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# setup.py uses it to create the tables and load the sheets.
SUPABASE_DB_URL=

# Optional alternatives if you would rather not share the database password:
#   SUPABASE_ACCESS_TOKEN   personal access token (https://supabase.com/dashboard/account/tokens): creates the tables
#   SUPABASE_SERVICE_ROLE_KEY  service role key (Project Settings > API): loads the sheets through the REST API
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps (Google Cloud > APIs & Services > Credentials; enable "Maps JavaScript API") ---
GOOGLE_MAPS_API_KEY=

# --- Where the four Google Sheets exports are (default: ~/Downloads) ------------
SEONI_SHEETS_DIR=~/Downloads
